# Optional cloud speech-to-text for /api/transcribe.
# Groq Whisper is fast and has a free tier; OpenAI is the fallback.
GROQ_API_KEY=
OPENAI_API_KEY=

# Public HTTPS origin of the separately deployed new_classic_mode FastAPI service.
# Local development defaults to http://127.0.0.1:8000.
CLASSIC_API_ORIGIN=
