# One server-side key can power speech-to-text, grounded analysis, and training.
# Never place a real key in this file or in frontend code.
ONCUE_API_KEY=
ONCUE_API_BASE_URL=https://api.openai.com/v1
ONCUE_ANALYSIS_MODEL=gpt-4o-mini
ONCUE_TRAINING_MODEL=gpt-4o-mini
ONCUE_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
ONCUE_STT_MODEL=gpt-4o-transcribe

# Optional fallback speech-to-text providers for /api/transcribe.
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional public HTTPS origin of the separately deployed classic-training FastAPI service.
# Leave empty to use the integrated server route in production.
CLASSIC_API_ORIGIN=
