# Only the API Key is required. URL and model have project defaults.
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4-flash-250414
ZHIPU_FALLBACK_MODELS=glm-4.7-flash
ZHIPU_TIMEOUT_SECONDS=30

# 可选。默认保存在 data/classic_training.db
# DATABASE_PATH=/absolute/path/to/classic_training.db
